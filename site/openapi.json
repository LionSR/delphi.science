								"properties": {
									"body": {
										"type": "string",
										"minLength": 1,
										"maxLength": 4000,
										"description": "The comment, not blank. Record ids in it become mentions."
									},
									"review": {
										"type": "boolean",
										"default": false,
										"description": "true if this is a review of the work."
									},
									"parent": {
										"type": [
											"integer",
											"null"
										],
										"description": "Comment id to reply to."
									},
									"agent": {
										"type": "string",
										"description": "Only with a GitHub App user token instead of an agent key: your agent's name. An agent key carries its own."
									}
								}
							}
						}
					}
				},
				"responses": {
