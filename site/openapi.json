{
	"openapi": "3.1.0",
	"info": {
		"title": "Open Research Index",
		"version": "1.0.0",
		"contact": {
			"name": "Support",
			"url": "https://open-research-index.vercel.app/support"
		},
		"description": "Research, AI-made and human, beside what experts said about it. A record carries its responses (arXiv replies, blog posts, talks, MathOverflow, X posts) with author, date and a quote from the source. Reads need no key. The same reads are an MCP server at https://open-research-index.vercel.app/mcp (Streamable HTTP, no key). Overview for agents: https://open-research-index.vercel.app/llms.txt"
	},
	"servers": [
		{
			"url": "https://open-research-index.vercel.app"
		}
	],
	"paths": {
		"/api/v1/search": {
			"get": {
				"operationId": "searchRecords",
				"security": [],
				"summary": "Search the index with arXiv-style queries. Use it to find a paper and see whether experts responded to it (discussed > 0, or is:discussed in the query) and whether any found a problem (disputed, or is:disputed).",
				"description": "The query language:\n\n- ti: au: abs: all: title, author, abstract, every text field (a bare word searches all)\n- cat: arXiv division or subdivision: cat:math, cat:math.NT, cat:quant-ph, or a subject name in quotes\n- source: category: origin: family: id: exact values, e.g. source:openai-math id:app/APP-260923-0000\n- is: formalized (has a Lean formalization), verified (Lean checked it at Palomar, or it passed APP verification), withdrawn (withdrawn at its source), agent-ready (ships instructions for agents, on agenticpapers.app), ai-generated (the source says AI made it), app (from agenticpapers.app), gone (its source no longer serves it), discussed (has posts or articles about it), disputed (a response refutes or questions it)\n- published: published:[2026-10-01 TO *], published:2026-09\n- Operators: AND, OR, ANDNOT, NOT (uppercase), parentheses, \"quoted phrases\", word* prefixes; adjacent terms are ANDed",
				"parameters": [
					{
						"name": "q",
						"in": "query",
						"schema": {
							"type": "string",
							"maxLength": 2000
						},
						"example": "cat:math.NT",
						"description": "arXiv-style query. ti: au: abs: all: title, author, abstract, every text field (a bare word searches all); cat: arXiv division or subdivision: cat:math, cat:math.NT, cat:quant-ph, or a subject name in quotes; source: category: origin: family: id: exact values, e.g. source:openai-math id:app/APP-260923-0000; is: formalized, verified, withdrawn, agent-ready, ai-generated, app, gone, discussed, disputed; published: published:[2026-10-01 TO *], published:2026-09. AND, OR, ANDNOT, NOT (uppercase), parentheses, \"quoted phrases\", word* prefixes; adjacent terms are ANDed. Empty lists everything."
					},
					{
						"name": "sort",
						"in": "query",
						"schema": {
							"type": "string",
							"enum": [
								"relevance",
								"newest",
								"oldest",
								"title",
								"score",
								"day",
								"week",
								"month",
								"mentions",
								"responded"
							]
						},
						"description": "relevance (default with a query), newest (default without), oldest, title, score (votes plus linked responses that confirm, simplify or extend it or have no stance yet, all time), day, week, month (votes and such responses published in that window), mentions (most cited in comments: how many people's comments name the record by id, then the newest; not linked posts, which count in score), responded (the newest expert response first, whatever its stance)."
					},
					{
						"name": "limit",
						"in": "query",
						"schema": {
							"type": "integer",
							"minimum": 1,
							"maximum": 100,
							"default": 20
						},
						"description": "Results per page, from 1 to 100; 20 if left out."
					},
					{
						"name": "cursor",
						"in": "query",
						"schema": {
							"type": "string",
							"maxLength": 200
						},
						"description": "next_cursor from the previous page, unchanged."
					},
					{
						"name": "fields",
						"in": "query",
						"schema": {
							"type": "string",
							"enum": [
								"compact",
								"full"
							],
							"default": "compact"
						},
						"description": "full returns each record whole, with discussion[]."
					},
					{
						"name": "format",
						"in": "query",
						"schema": {
							"type": "string",
							"enum": [
								"json",
								"md"
							],
							"default": "json"
						},
						"example": "md",
						"description": "md returns a short Markdown list (title, link, id, date, subject, score) to paste into context."
					}
				],
				"responses": {
					"200": {
						"description": "Matching records, one page",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/SearchResult"
								}
							},
							"text/markdown": {
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"400": {
						"description": "An error with a fix to try",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/records/{prefix}/{suffix}": {
			"get": {
				"operationId": "getRecord",
				"security": [],
				"summary": "One record in full: metadata, votes, reception (where the work stands, reviewed by a person), and discussion[], the expert responses to it with author, date and quote. discusses[] lists the records it responds to.",
				"parameters": [
					{
						"name": "prefix",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						},
						"example": "app",
						"description": "The source part of a record id, e.g. arxiv, openai-math, app. A record id is <prefix>/<suffix>, like a DOI."
					},
					{
						"name": "suffix",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						},
						"example": "APP-260923-0000",
						"description": "The source's own id, e.g. 2610.20058 or The-Quasi-Riemann-Hypothesis."
					}
				],
				"responses": {
					"200": {
						"description": "The record",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Record"
								}
							}
						}
					},
					"404": {
						"description": "An error with a fix to try",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
