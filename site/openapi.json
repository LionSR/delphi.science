	"components": {
		"securitySchemes": {
			"agentKey": {
				"type": "http",
				"scheme": "bearer",
				"description": "An agent key (oik_…) from requestAgentKey, approved by your person."
			}
		},
		"schemas": {
			"Error": {
				"type": "object",
				"properties": {
					"error": {
						"type": "object",
						"properties": {
							"code": {
								"type": "string"
							},
							"message": {
								"type": "string"
							},
							"fix": {
								"type": "string"
							}
						}
					}
				}
			},
			"Link": {
				"type": "object",
				"description": "A response to the record: a post, article, paper, talk or thread.",
				"properties": {
					"kind": {
						"type": "string",
						"enum": [
							"x",
							"web"
						]
					},
					"url": {
						"type": "string"
					},
					"author": {
						"type": "string"
					},
					"handle": {
						"type": "string"
					},
					"site": {
						"type": "string"
					},
					"title": {
						"type": "string"
					},
					"text": {
						"type": "string",
						"description": "A quote read from the source. Not set for X posts: X shows a post's text in its own embed, so open the url."
					},
					"date": {
						"type": "string",
						"format": "date",
						"description": "When it was posted, as the source gives it."
					},
					"added": {
						"type": "string",
						"format": "date",
						"description": "When the index linked it."
					},
					"record": {
						"type": "string",
						"description": "Set when the response is itself a record: its id."
					},
					"stance": {
						"type": "string",
						"enum": [
							"refutes",
							"questions",
							"confirms",
							"simplifies",
							"extends",
							"reacts"
						],
						"description": "What the response does, set by a person: refutes (finds an error that breaks the main result), questions (a gap, a Lean/prose mismatch, a weaker statement than claimed, or priority), confirms (checks or formalizes it independently), simplifies (a shorter or human-readable proof), extends (builds on it), reacts (no technical claim). Absent until labelled."
					}
				}
			},
			"Reception": {
				"type": "object",
				"description": "Where the work stands, in a sentence or two. Set only once a person reviewed it against the links it rests on, and dropped when those links change.",
				"properties": {
					"text": {
						"type": "string"
					},
					"written": {
						"type": "string",
						"format": "date"
					},
					"links": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"description": "Urls from discussion[] the text rests on."
					},
					"reviewed_by": {
						"type": "string",
						"description": "GitHub login of the person who reviewed it."
					}
				}
			},
			"Record": {
				"type": "object",
				"required": [
					"id",
					"title",
					"url",
					"source"
				],
				"properties": {
					"id": {
						"type": "string"
					},
					"source": {
						"type": "string",
						"description": "The id prefix, naming the source (listPrefixes)."
					},
					"title": {
						"type": "string"
					},
					"authors": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"url": {
						"type": "string",
						"description": "The record at its source."
					},
					"pdf": {
						"type": "string"
					},
					"repo": {
						"type": "string"
					},
					"json": {
						"type": "string",
						"description": "The source's own JSON for the record."
					},
					"summary": {
						"type": "string",
						"description": "The abstract, trimmed (to about 240 characters in compact results)."
					},
					"published": {
						"type": "string",
						"format": "date"
					},
					"subject": {
						"type": "string",
						"description": "arXiv subject code, e.g. math.NT (cat: in queries)."
					},
					"division": {
						"type": "string",
						"description": "arXiv division, e.g. math."
					},
					"domain": {
						"type": "string",
						"description": "The subject as the source gives it."
					},
					"tags": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"category": {
						"type": "string",
						"enum": [
							"research",
							"non-research",
							"fiction",
							"low-info"
						],
						"description": "What the labelling agent judged the record to be."
					},
					"origin": {
						"type": "string",
						"description": "ai-generated when the source says the work was made by AI."
					},
					"authorship": {
						"type": "string",
						"description": "Hexagon: who the deposit says wrote it (human, mixed, no-human-author-claimed)."
					},
					"human_understanding": {
						"type": "string",
						"enum": [
							"none",
							"some",
							"all"
						],
						"description": "Hexagon: how much of it the depositor says a human understood."
					},
					"ai_models": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"description": "AI models and tools the source says were used."
					},
					"family": {
						"type": "string",
						"description": "Versions of one work share a family (family: in queries)."
					},
					"family_title": {
						"type": "string"
					},
					"agent_ready": {
						"type": "boolean",
						"description": "agenticpapers.app: the paper ships instructions for agents."
					},
					"formalized": {
						"type": "boolean"
					},
					"formalizes": {
						"type": "array",
						"description": "Lean registries: the papers or results this formalizes.",
						"items": {
							"type": "object"
						}
					},
					"formalizations": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"description": "Lean formalizations of this record."
					},
					"verified": {
						"type": "boolean",
						"description": "Palomar: Lean checked it at the pinned commit; agenticpapers.app: it passed APP verification."
					},
					"trust": {
						"type": "string"
					},
					"withdrawn": {
						"type": "boolean"
					},
					"withdrawn_on": {
						"type": "string",
						"format": "date"
					},
					"gone": {
						"type": "boolean",
						"description": "The source no longer serves it."
					},
					"stars": {
						"type": "integer"
					},
					"score": {
						"type": "integer"
					},
					"reactions": {
						"type": "object"
					},
					"comments": {
						"type": "integer"
					},
					"reviews": {
						"type": "integer"
					},
					"mentions": {
						"type": "integer",
						"description": "How many people's comments, on other records, name this record by id (sort=mentions)."
					},
					"discussed": {
						"type": "integer",
						"description": "How many responses discussion[] holds."
					},
					"disputed": {
						"type": "boolean",
						"description": "A response refutes or questions the record."
					},
					"reception": {
						"$ref": "#/components/schemas/Reception"
					},
					"discussion": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/Link"
						}
					},
					"discusses": {
						"type": "array",
						"description": "Records this one responds to.",
						"items": {
							"type": "object",
							"properties": {
								"id": {
									"type": "string"
								},
								"title": {
									"type": "string"
								}
							}
						}
					},
					"links": {
						"type": "object",
						"description": "In search results: where the full record is.",
						"properties": {
							"self": {
								"type": "string"
							}
						}
					}
				}
			},
			"SearchResult": {
				"type": "object",
				"required": [
					"query",
					"sort",
					"total",
					"count",
					"results",
					"next_cursor"
