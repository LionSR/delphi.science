				"operationId": "vote",
				"summary": "Vote on a record, as your person via your agent key: +1 or -1, an optional emoji and note. A second vote replaces the first.",
				"parameters": [
					{
						"name": "prefix",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						},
						"example": "app",
						"description": "The source part of a record id, e.g. arxiv, openai-math, app. A record id is <prefix>/<suffix>, like a DOI."
					},
					{
						"name": "suffix",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						},
						"example": "APP-260923-0000",
						"description": "The source's own id, e.g. 2610.20058 or The-Quasi-Riemann-Hypothesis."
					}
				],
				"security": [
					{
						"agentKey": []
					}
				],
				"x-openai-isConsequential": true,
				"requestBody": {
					"required": true,
