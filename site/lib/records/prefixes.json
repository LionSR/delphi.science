{
 "about": "Every record ID has the form <prefix>/<suffix>, where <prefix> identifies the upstream source and <suffix> is the source's identifier. Prefixes are permanent and never reused; retired prefixes indicate sources no longer indexed.",
 "prefixes": {
  "app": {"name": "agenticpapers.app", "home": "https://agenticpapers.app", "suffix": "APP id", "example": "app/APP-260923-0000", "since": "2026-10-24"},
  "openai-math": {"name": "OpenAI Math", "home": "https://github.com/openai/math", "suffix": "preprint folder", "example": "openai-math/Tangent-flow-uniqueness", "since": "2026-10-24"},
  "palomar": {"name": "Palomar Registry", "home": "https://palomar-registry.org", "suffix": "Palomar id", "example": "palomar/PALOMAR-2026-10-17-000014", "since": "2026-10-24"},
  "anthropic-science": {"name": "Anthropic Science", "home": "https://www.anthropic.com/science", "suffix": "post slug", "example": "anthropic-science/claude-scorpion-toxin-binder-design", "since": "2026-10-24"},
  "lean": {"name": "Lean project", "home": "https://lean-lang.org", "suffix": "owner__repo, then __path for a file in it", "example": "lean/anthropics__fermats-last-theorem", "since": "2026-10-24"},
  "cogentic": {"name": "Cogentic", "home": "https://github.com/google-research/google-research/tree/master/cogentic_research_papers", "suffix": "paper folder", "example": "cogentic/integer_factorization", "since": "2026-11-25"},
  "yang-mills-group": {"name": "Yang–Mills group", "home": "https://github.com/yang-mills-group", "suffix": "submission repository", "example": "yang-mills-group/OpenAI-YM-20261028", "since": "2026-11-26"},
  "formal-conjectures": {"name": "Formal Conjectures", "home": "https://github.com/google-deepmind/formal-conjectures", "suffix": "path of the Lean file under FormalConjectures/, with / written as __", "example": "formal-conjectures/Wikipedia__Andrica", "since": "2026-11-25"},
  "ai-scientist": {"name": "AI Scientist", "home": "https://github.com/SakanaAI/AI-Scientist", "suffix": "example paper name", "retired": "2026-10-24", "example": "ai-scientist/adaptive_dual_scale_denoising", "since": "2026-10-24"},
  "clawxiv": {"name": "clawXiv", "home": "https://clawxiv.org", "suffix": "clawXiv id", "retired": "2026-10-24", "example": "clawxiv/clawxiv.2610.00001", "since": "2026-10-24"},
  "aixiv": {"name": "aiXiv", "home": "https://aixiv.science", "suffix": "aiXiv id", "retired": "2026-10-24", "example": "aixiv/aixiv.261018.000001", "since": "2026-10-24"},
  "aivixra": {"name": "ai.viXra", "home": "https://ai.vixra.org", "suffix": "viXra id", "retired": "2026-10-24", "example": "aivixra/2610.0048", "since": "2026-10-24"},
  "jaigp": {"name": "JAIGP", "home": "https://jaigp.org", "suffix": "paper number", "retired": "2026-10-24", "example": "jaigp/104", "since": "2026-10-24"},
  "hexagon": {"name": "Hexagon", "home": "https://hexagonmath.org", "suffix": "Hexagon id, without version", "example": "hexagon/2610.00292", "since": "2026-10-24"},
  "zenodo": {"name": "Zenodo", "home": "https://zenodo.org", "suffix": "record number", "example": "zenodo/23571342", "since": "2026-10-24"},
