{
  "name": "open-index-site",
  "private": true,
  "type": "module",
  "imports": {
    "#app/*": "./app/*",
    "#lib/*": "./lib/*",
    "#scripts/*": "./scripts/*"
  },
  "description": "The open index: pages and the agent API (Next.js on Vercel), over Supabase Postgres.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test --experimental-strip-types 'lib/**/*.test.ts'",
    "plugin": "node --experimental-strip-types scripts/plugin.ts",
    "openapi": "node --experimental-strip-types scripts/openapi.ts",
    "db": "node --experimental-strip-types scripts/db.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@octokit/oauth-methods": "6.0.5",
    "@vercel/analytics": "2.0.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "next": "16.4.3",
    "postgres": "3.4.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-mathjax": "7.1.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.15",
    "@electric-sql/pglite-socket": "0.0.21",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "katex": "0.18.2"
  }
}
